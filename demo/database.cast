[4.557273457990959, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> [where <столбец> = <значение>] - прочитать\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n<command> info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<comm"]
[4.557294541038573, "o", "and> help - справочная информация\r\nТипы: int, str, bool. Строки в кавычках, bool: true или false.\r\n\r\n"]
[4.557306625065394, "o", ">>>Введите команду: "]
[6.562367832986638, "o", "create_table users name:str age:int is_active:bool\r\n"]
[6.563327750074677, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.563342040986754, "o", ">>>Введите команду: "]
[8.568396916030906, "o", "list_tables\r\n"]
[8.568581833038479, "o", "- users\r\n>>>Введите команду: "]
[10.571154583012685, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[10.571503875078633, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[10.57192258303985, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n"]
[10.571932833059691, "o", ">>>Введите команду: "]
[12.576986083062366, "o", "insert into users values (\"Anna, where = set\", 20, false)\r\n"]
[12.577282750047743, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[12.57769491604995, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[12.577708582975902, "o", ">>>Введите команду: "]
[14.582766583072953, "o", "select from users\r\n"]
[14.583022541017272, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.814131916034967, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  28 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n>>>Введите команду: "]
[16.814709083060734, "o", "select from users where name = \"Sergei\"\r\n"]
[16.815036625019275, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.81516816606745, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[16.815175457973965, "o", ">>>Введите команду: "]
[18.820227207965218, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[18.821002625045367, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[18.82101141603198, "o", ">>>Введите команду: "]
[20.823055541026406, "o", "select from users where age = 29\r\n"]
[20.82331366604194, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[20.823443375062197, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[20.823453000048175, "o", ">>>Введите команду: "]
[22.825086166034453, "o", "insert into users values (\"Wrong\", \"age\", true)\r\n"]
[22.82534125004895, "o", "Ошибка валидации: Для столбца age требуется тип int.\r\n"]
[22.825345415971242, "o", ">>>Введите команду: "]
[24.830391208059154, "o", "delete from users where ID = 1\r\n"]
[24.830632457975298, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[26.831389207975008, "o", "n\r\n"]
[26.831428416073322, "o", "Операция отменена.\r\n"]
[26.83143329108134, "o", ">>>Введите команду: "]
[28.833212208002806, "o", "select from users\r\n"]
[28.833442999981344, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[28.833571208058856, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  29 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n"]
[28.833577166078612, "o", ">>>Введите команду: "]
[30.83865891606547, "o", "delete from users where ID = 1\r\n"]
[30.83885904098861, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[32.84197195805609, "o", "y\r\n"]
[32.84250545804389, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n>>>Введите команду: "]
[34.8475641249679, "o", "select from users\r\n"]
[34.84778704098426, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[34.84791062504519, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n>>>Введите команду: "]
[36.85296420799568, "o", "info users\r\n"]
[36.85314554104116, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[36.85315049998462, "o", "Количество записей: 1\r\n"]
[36.85315375006758, "o", ">>>Введите команду: "]
[38.85821133304853, "o", "drop_table users\r\n"]
[38.85834941605572, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[40.8634000410093, "o", "y\r\n"]
[40.86394183302764, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[42.86474870797247, "o", "list_tables\r\n"]
[42.864966416032985, "o", "Таблиц пока нет.\r\n"]
[42.864974125055596, "o", ">>>Введите команду: "]
[44.87002425000537, "o", "exit\r\n"]
[44.87653100001626, "o", "demo$ "]
[46.88162220804952, "o", "exit\r\nexit\r\n"]
