{"version": 2, "width": 120, "height": 40, "timestamp": 1794156723, "title": "primitive_db: установка и полный CRUD", "env": {"TERM": "dumb", "SHELL": "/bin/sh"}}
[0.0041709160432219505, "o", "demo$ "]
[0.2592662910465151, "o", "make install\r\n"]
[0.28056241606827825, "o", "uv --quiet sync --locked\r\n"]
[21.09037900005933, "o", "demo$ "]
[21.34541854111012, "o", "uv run database\r\n"]
[21.908082083100453, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> [where <столбец> = <значение>] - прочитать\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n<command> info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<comm"]
[21.90809691604227, "o", "and> help - справочная информация\r\nТипы: int, str, bool. Строки в кавычках, bool: true или false.\r\n\r\n"]
[21.908116166014224, "o", ">>>Введите команду: "]
[22.16000883304514, "o", "create_table users name:str age:int is_active:bool\r\n"]
[22.161627541063353, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[22.161638708086684, "o", ">>>Введите команду: "]
[22.41577295807656, "o", "list_tables\r\n"]
[22.41589850001037, "o", "- users\r\n"]
[22.41591750003863, "o", ">>>Введите команду: "]
[22.669906916096807, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[22.670204458059743, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[22.670593333081342, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>>Введите команду: "]
[22.92563841608353, "o", "insert into users values (\"Anna, where = set\", 20, false)\r\n"]
[22.92590883304365, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[22.926286333007738, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[22.926297041005455, "o", ">>>Введите команду: "]
[23.17669391608797, "o", "select from users\r\n"]
[23.17690870806109, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[23.45413450000342, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  28 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n>>>Введите команду: "]
[23.70919266610872, "o", "select from users where name = \"Sergei\"\r\n"]
[23.709449416026473, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[23.709565458004363, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[23.709571041050367, "o", ">>>Введите команду: "]
[23.96462045807857, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[23.965211791102774, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n>>>Введите команду: "]
[24.218346458044834, "o", "select from users where age = 29\r\n"]
[24.218590416014194, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[24.21870295808185, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[24.21870662504807, "o", ">>>Введите команду: "]
[24.47045166604221, "o", "insert into users values (\"Wrong\", \"age\", true)\r\n"]
[24.470673833042383, "o", "Ошибка валидации: Для столбца age требуется тип int.\r\n>>>Введите команду: "]
[24.72494612506125, "o", "delete from users where ID = 1\r\n"]
[24.72516220808029, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[24.977354750037193, "o", "n\r\n"]
[24.977369250031188, "o", "Операция отменена.\r\n"]
[24.97738245804794, "o", ">>>Введите команду: "]
[25.230354458093643, "o", "select from users\r\n"]
[25.230575375026092, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[25.2307038330473, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  29 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n>>>Введите команду: "]
[25.48575108300429, "o", "delete from users where ID = 1\r\n"]
[25.48596066609025, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[25.73809829109814, "o", "y\r\n"]
[25.73852854105644, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n>>>Введите команду: "]
[25.992579791112803, "o", "select from users\r\n"]
[25.9927875000285, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[25.992895458010025, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n"]
[25.99290866602678, "o", ">>>Введите команду: "]
[26.246204166091047, "o", "info users\r\n"]
[26.246381333097816, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\n"]
[26.246387458057143, "o", "Количество записей: 1\r\n>>>Введите команду: "]
[26.501436458085664, "o", "drop_table users\r\n"]
[26.501593250082806, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[26.756638666032813, "o", "y\r\n"]
[26.757094458094798, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[27.012148250010796, "o", "list_tables\r\n"]
[27.012289625010453, "o", "Таблиц пока нет.\r\n>>>Введите команду: "]
[27.267336000106297, "o", "exit\r\n"]
[27.273143208003603, "o", "demo$ "]
[27.273186375037767, "o", "exit\r\nexit\r\n"]
