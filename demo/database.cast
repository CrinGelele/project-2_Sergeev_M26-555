{"version": 2, "width": 120, "height": 40, "timestamp": 1794162845, "title": "primitive_db: установка и полный CRUD", "env": {"TERM": "dumb", "SHELL": "/bin/sh"}}
[0.00621058396063745, "o", "demo$ "]
[2.0112989170011133, "o", "make install\r\n"]
[2.0323591670021415, "o", "uv --quiet sync --locked\r\n"]
[2.0680717499926686, "o", "demo$ "]
[4.070100749959238, "o", "uv run database\r\n"]
[4.438945667003281, "o", "\r\n***Процесс работы с таблицей***\r\nФункции:\r\n<command> create_table <имя_таблицы> <столбец1:тип> .. - создать таблицу\r\n<command> list_tables - показать список всех таблиц\r\n<command> drop_table <имя_таблицы> - удалить таблицу\r\n\r\n***Операции с данными***\r\n<command> insert into <имя_таблицы> values (<значение1>, ...) - создать запись\r\n<command> select from <имя_таблицы> [where <столбец> = <значение>] - прочитать\r\n<command> update <имя_таблицы> set <столбец> = <значение> where <столбец> = <значение>\r\n<command> delete from <имя_таблицы> where <столбец> = <значение> - удалить записи\r\n<command> info <имя_таблицы> - информация о таблице\r\n\r\nОбщие команды:\r\n<command> exit - выход из программы\r\n<comm"]
[4.438960083993152, "o", "and> help - справочная информация\r\nТипы: int, str, bool. Строки в кавычках, bool: true или false.\r\n\r\n"]
[4.438967916998081, "o", ">>>Введите команду: "]
[6.444029708974995, "o", "create_table users name:str age:int is_active:bool\r\n"]
[6.444909458979964, "o", "Таблица \"users\" успешно создана со столбцами: ID:int, name:str, age:int, is_active:bool\r\n"]
[6.444922249997035, "o", ">>>Введите команду: "]
[8.44997575005982, "o", "list_tables\r\n"]
[8.450136417057365, "o", "- users\r\n>>>Введите команду: "]
[10.455197209026664, "o", "insert into users values (\"Sergei\", 28, true)\r\n"]
[10.455516624962911, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[10.455937208957039, "o", "Запись с ID=1 успешно добавлена в таблицу \"users\".\r\n>>>Введите команду: "]
[12.46069375006482, "o", "insert into users values (\"Anna, where = set\", 20, false)\r\n"]
[12.460985917015933, "o", "Функция insert выполнилась за 0.000 секунд\r\n"]
[12.461372458958067, "o", "Запись с ID=2 успешно добавлена в таблицу \"users\".\r\n"]
[12.461377625004388, "o", ">>>Введите команду: "]
[14.464858041959815, "o", "select from users\r\n"]
[14.465096791973338, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[14.698799167061225, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  28 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n>>>Введите команду: "]
[16.70235308399424, "o", "select from users where name = \"Sergei\"\r\n"]
[16.702612624969333, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[16.702731500030495, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  28 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[16.70273758401163, "o", ">>>Введите команду: "]
[18.70332279196009, "o", "update users set age = 29 where name = \"Sergei\"\r\n"]
[18.704048792016692, "o", "Запись с ID=1 в таблице \"users\" успешно обновлена.\r\n"]
[18.7040584590286, "o", ">>>Введите команду: "]
[20.707064750022255, "o", "select from users where age = 29\r\n"]
[20.70730829203967, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[20.707426625071093, "o", "+----+--------+-----+-----------+\r\n| ID |  name  | age | is_active |\r\n+----+--------+-----+-----------+\r\n| 1  | Sergei |  29 |    True   |\r\n+----+--------+-----+-----------+\r\n"]
[20.707431250019, "o", ">>>Введите команду: "]
[22.711662375018932, "o", "insert into users values (\"Wrong\", \"age\", true)\r\n"]
[22.711940375040285, "o", "Ошибка валидации: Для столбца age требуется тип int.\r\n>>>Введите команду: "]
[24.717001875047572, "o", "delete from users where ID = 1\r\n"]
[24.71725404204335, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[26.722314042039216, "o", "n\r\n"]
[26.72233833395876, "o", "Операция отменена.\r\n"]
[26.722346249967813, "o", ">>>Введите команду: "]
[28.726506834034808, "o", "select from users\r\n"]
[28.72682600002736, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[28.72697379195597, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 1  |       Sergei      |  29 |    True   |\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n"]
[28.726982000051066, "o", ">>>Введите команду: "]
[30.732069708989002, "o", "delete from users where ID = 1\r\n"]
[30.732267791987397, "o", "Вы уверены, что хотите выполнить \"удаление записей\"? [y/n]: "]
[32.73667504196055, "o", "y\r\n"]
[32.73727499996312, "o", "Запись с ID=1 успешно удалена из таблицы \"users\".\r\n"]
[32.737283917027526, "o", ">>>Введите команду: "]
[34.73794595897198, "o", "select from users\r\n"]
[34.73816125001758, "o", "Функция select выполнилась за 0.000 секунд\r\n"]
[34.73826837504748, "o", "+----+-------------------+-----+-----------+\r\n| ID |        name       | age | is_active |\r\n+----+-------------------+-----+-----------+\r\n| 2  | Anna, where = set |  20 |   False   |\r\n+----+-------------------+-----+-----------+\r\n"]
[34.73827908397652, "o", ">>>Введите команду: "]
[36.7433379170252, "o", "info users\r\n"]
[36.74367816699669, "o", "Таблица: users\r\nСтолбцы: ID:int, name:str, age:int, is_active:bool\r\nКоличество записей: 1\r\n"]
[36.74369883397594, "o", ">>>Введите команду: "]
[38.74501291697379, "o", "drop_table users\r\n"]
[38.745194916962646, "o", "Вы уверены, что хотите выполнить \"удаление таблицы\"? [y/n]: "]
[40.74771787505597, "o", "y\r\n"]
[40.74827674997505, "o", "Таблица \"users\" успешно удалена.\r\n>>>Введите команду: "]
[42.75332424999215, "o", "list_tables\r\n"]
[42.75349400006235, "o", "Таблиц пока нет.\r\n>>>Введите команду: "]
[44.758548584068194, "o", "exit\r\n"]
[44.7649988749763, "o", "demo$ "]
[46.77009708399419, "o", "exit\r\nexit\r\n"]
